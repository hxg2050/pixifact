{
  "name": "pixifact-workspace",
  "version": "0.1.3",
  "description": "Pixifact framework、Editor 和 CLI 的 workspace。",
  "private": true,
  "workspaces": [
    "packages/*",
    "apps/*",
    "sample-projects/*"
  ],
  "packageManager": "bun@1.3.13",
  "type": "module",
  "files": [
    "skills/",
    "scripts/install-skills.mjs"
  ],
  "bin": {
    "pixifact-skills": "scripts/install-skills.mjs"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/hxg2050/pixifact.git"
  },
  "keywords": [
    "ai-editor",
    "game-editor",
    "pixijs",
    "scene",
    "runtime"
  ],
  "author": "youxia <243802688@qq.com>",
  "license": "MIT",
  "scripts": {
    "build": "cd packages/pixifact && bun run build",
    "changeset": "changeset",
    "editor": "bun run editor:frontend:build && bun run pixifact -- editor",
    "editor:typecheck": "bunx --no-install vue-tsc --noEmit -p apps/editor/tsconfig.json",
    "pixifact": "bun packages/pixifact-cli/src/pixifact-cli.ts",
    "editor:frontend:build": "bunx --no-install vite build apps/editor --config vite.config.ts",
    "release:check": "bun run test && bun run build && bun run editor:frontend:build && cd packages/create-pixifact && bun run build && cd ../.. && bun scripts/check-release-packages.mjs",
    "release:publish": "bun scripts/publish-release-tag.mjs",
    "release:status": "changeset status --verbose",
    "release:version": "changeset version && bun scripts/sync-template-versions.mjs && bun install --lockfile-only",
    "skills:install": "bun scripts/install-skills.mjs --replace",
    "test": "bunx --no-install vitest run",
    "test:watch": "bunx --no-install vitest"
  },
  "devDependencies": {
    "@changesets/cli": "^2.31.0",
    "@rollup/plugin-typescript": "^11.1.6",
    "@tauri-apps/cli": "2.11.1",
    "@types/bun": "^1.3.14",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-vue": "^6.0.8",
    "@vue/test-utils": "^2.4.11",
    "happy-dom": "^20.9.0",
    "pixi.js": "8.18.1",
    "rollup": "^4.9.4",
    "tslib": "^2.6.2",
    "typescript": "^5.3.3",
    "vite": "^8.0.10",
    "vitest": "^4.1.5",
    "vue-tsc": "^3.3.8"
  },
  "dependencies": {
    "dockview-react": "6.6.1",
    "lucide-react": "^1.14.0",
    "lucide-vue-next": "^1.0.0",
    "pinia": "^4.0.2",
    "react": "^19.2.5",
    "react-aria-components": "^1.17.0",
    "react-dom": "^19.2.5",
    "reka-ui": "^2.10.1",
    "vue": "^3.5.40",
    "zod": "^4.4.3",
    "zustand": "^5.0.12"
  }
}
