    "validate:douyin": "bun ../../packages/pixifact-cli/src/pixifact-cli.ts validate --mode douyin --project-root .",
    "build:douyin": "bun ../../packages/pixifact-cli/src/pixifact-cli.ts build --mode douyin --project-root .",
