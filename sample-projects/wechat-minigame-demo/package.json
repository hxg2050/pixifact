{
  "name": "pixifact-wechat-minigame-demo",
  "version": "0.1.1",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "bun ../../packages/pixifact-cli/src/pixifact-cli.ts dev --mode web --project-root .",
    "validate:web": "bun ../../packages/pixifact-cli/src/pixifact-cli.ts validate --mode web --project-root .",
