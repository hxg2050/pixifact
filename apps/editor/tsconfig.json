{
  "extends": "../../tsconfig.json",
  "compilerOptions": {
    "noEmit": true,
    "noImplicitReturns": false,
    "noUnusedLocals": false,
    "noUnusedParameters": false,
    "types": ["vite/client"]
  },
  "include": [
    "src/**/*.ts",
    "src/**/*.vue"
  ],
  "exclude": [
    "src/**/*.tsx"
  ]
}
