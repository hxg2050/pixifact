<Scene name="Panel" width="620" height="400">
  <NineImage id="background" texture="assets/ui/panel.svg" left="0" right="0" top="0" bottom="0" leftWidth="24" rightWidth="24" topHeight="24" bottomHeight="24" eventMode="none" />
