<Scene name="MainMenu" width="1080" height="1920">
  <Panel id="page" scene="../ui/Panel.scene" left="0" right="0" top="0" bottom="0" title="Pixifact / UI 组件库">
    <ScrollContainer id="menuScroll" slot="content" left="0" right="0" top="0" bottom="0" direction="vertical">
      <VBoxContainer id="menuContent" width="1016" height="1424" gap="24" alignX="center">
        <Group id="intro" width="1016" height="144">
          <Label id="headline" left="8" right="8" top="0" height="72" text="基础组件，直接试用" fontSize="54" fontWeight="700" fill="#25322d" alignY="center" />
          <Label id="description" left="8" right="8" top="88" height="48" text="四个组件，两套外观，点击查看状态。" fontSize="32" fill="#516158" alignY="center" />
        </Group>

        <Panel id="buttonsPanel" scene="../ui/Panel.scene" width="1016" height="384" title="01 / Button 按钮">
          <Group id="buttonsContent" slot="content" left="0" right="0" top="0" bottom="0">
            <Group id="sizeRow" horizontal="0" top="0" width="888" height="96">
              <Button id="sampleButton" scene="../ui/Button.scene" left="0" top="0" width="360" height="96" size="large" text="大号" @clicked="click">
                <Group id="sampleIcon" slot="icon" left="0" right="0" top="0" bottom="0" eventMode="none">
                  <Label id="star" left="0" right="0" top="0" bottom="0" text="★" fontSize="36" fill="#25322d" alignX="center" alignY="center" />
                </Group>
              </Button>
              <Button id="mediumButton" scene="../ui/Button.scene" left="384" top="8" width="280" height="80" size="medium" text="中号" @clicked="click" />
              <Button id="smallButton" scene="../ui/Button.scene" right="0" top="16" width="200" height="64" size="small" text="小号" @clicked="click" />
            </Group>
            <Group id="stateRow" horizontal="0" top="120" width="584" height="80">
              <Button id="disabledButton" scene="../ui/Button.scene" left="0" top="0" width="280" height="80" text="{previewText}" disabled="{previewDisabled}" @clicked="click" />
              <Button id="toggleButton" scene="../ui/Button.scene" right="0" top="0" width="280" height="80" text="{toggleText}" @clicked="togglePreview" />
            </Group>
            <Label id="clickCount" left="0" right="0" top="216" height="40" text="{clickText}" fontSize="32" fill="#516158" alignX="center" alignY="center" />
          </Group>
        </Panel>

        <Panel id="progressPanel" scene="../ui/Panel.scene" width="1016" height="288" title="02 / ProgressBar 进度条">
          <Group id="progressContent" slot="content" left="0" right="0" top="0" bottom="0">
            <Label id="progressLabel" left="0" right="0" top="0" height="40" text="{progressText}" fontSize="30" fill="#516158" alignY="center" />
            <ProgressBar id="progressBar" scene="../ui/ProgressBar.scene" left="0" right="0" top="44" height="20" />
            <Group id="progressActions" horizontal="0" top="96" width="424" height="64">
              <Button id="decreaseButton" scene="../ui/Button.scene" left="0" top="0" width="200" height="64" size="small" text="− 25%" @clicked="decrease" />
              <Button id="increaseButton" scene="../ui/Button.scene" right="0" top="0" width="200" height="64" size="small" text="+ 25%" @clicked="increase" />
            </Group>
          </Group>
        </Panel>

        <Panel id="panelSample" scene="../ui/Panel.scene" width="1016" height="184" title="03 / Panel 面板">
          <Group id="panelContent" slot="content" left="0" right="0" top="0" bottom="0">
            <Label id="slotDescription" left="0" top="0" width="550" height="48" text="内容区可组合任意组件" fontSize="30" fill="#516158" alignY="center" />
            <Label id="record" right="0" top="0" width="300" height="48" text="{bestText}" fontSize="30" fill="#516158" alignX="end" alignY="center" />
          </Group>
        </Panel>

        <Panel id="dialogPanel" scene="../ui/Panel.scene" width="1016" height="224" title="04 / Dialog 弹窗">
          <Group id="dialogContent" slot="content" left="0" right="0" top="0" bottom="0">
            <Button id="dialogButton" scene="../ui/Button.scene" horizontal="0" top="8" width="360" height="80" text="{dialogText}" @clicked="openDialog" />
          </Group>
        </Panel>

        <Button id="startButton" scene="../ui/Button.scene" width="360" height="80" text="体验游戏流程" @clicked="start" />
      </VBoxContainer>
    </ScrollContainer>
  </Panel>
</Scene>
