<Scene name="ResultScreen" width="750" height="1334">
  <Panel id="page" scene="../ui/Panel.scene" width="750" height="1334" title="本局完成">
    <Group id="resultContent" slot="content" left="0" right="0" top="0" bottom="0">
      <Label id="headline" left="44" right="44" top="174" height="100" text="星光已收集" fontSize="50" fontWeight="700" fill="#25322d" alignX="center" alignY="center" />
      <Label id="score" left="48" right="48" top="348" height="64" text="{scoreText}" fontSize="32" fill="#25322d" alignX="center" />
      <Label id="record" left="48" right="48" top="438" height="56" text="{bestText}" fontSize="26" fill="#516158" alignX="center" />
      <Button id="restartButton" scene="../ui/Button.scene" horizontal="0" top="598" width="420" height="88" text="再玩一次" @clicked="restart" />
      <Button id="menuButton" scene="../ui/Button.scene" horizontal="0" top="722" width="420" height="88" text="返回菜单" @clicked="menu" />
    </Group>
  </Panel>
</Scene>
