<Scene name="ResultScreen" width="1080" height="1920">
  <Panel id="page" scene="../ui/Panel.scene" left="0" right="0" top="0" bottom="0" title="本局完成">
    <ScrollContainer id="resultScroll" slot="content" left="0" right="0" top="0" bottom="0" direction="vertical">
      <Group id="resultContent" width="1016" height="840">
        <Label id="headline" left="44" right="44" top="174" height="100" text="星光已收集" fontSize="50" fontWeight="700" fill="#25322d" alignX="center" alignY="center" />
        <Label id="score" left="48" right="48" top="348" height="64" text="{scoreText}" fontSize="32" fill="#25322d" alignX="center" />
        <Label id="record" left="48" right="48" top="438" height="56" text="{bestText}" fontSize="26" fill="#516158" alignX="center" />
        <Button id="restartButton" scene="../ui/Button.scene" horizontal="0" top="598" width="280" height="80" text="再玩一次" @clicked="restart" />
        <Button id="menuButton" scene="../ui/Button.scene" horizontal="0" top="694" width="360" height="80" text="返回组件展台" @clicked="menu" />
      </Group>
    </ScrollContainer>
  </Panel>
</Scene>
