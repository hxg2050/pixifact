<Scene name="Panel" width="620" height="400">
  <PanelBackground id="background" scene="./nine/PanelBackground.scene" left="0" right="0" top="0" bottom="0" />
  <Label id="titleLabel" text="{title}" left="32" right="32" top="24" height="48" fontSize="36" fontFamily="sans-serif" fontWeight="700" fill="#25322d" alignY="center" eventMode="none" />
  <Group id="contentHost" left="32" right="32" top="96" bottom="32">
    <slot name="content" />
  </Group>
</Scene>
