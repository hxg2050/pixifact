<Scene name="Button" width="280" height="80" eventMode="static" cursor="pointer" on:pointerdown="press" on:pointerup="release" on:pointerupoutside="release" on:pointerout="release" on:pointertap="activate">
  <Group id="visual" left="0" right="0" top="0" bottom="0" eventMode="none">
    <ButtonBackground id="background" scene="./nine/ButtonBackground.scene" left="0" right="0" top="0" bottom="0" />
    <Label id="label" text="{text}" left="{size.labelPadding}" right="{size.labelPadding}" top="0" bottom="0" fontSize="{size.fontSize}" fontFamily="sans-serif" fontWeight="700" fill="#25322d" alignX="center" alignY="center" eventMode="none" />
    <Group id="iconHost" left="{size.iconInset}" vertical="0" width="{size.iconSize}" height="{size.iconSize}" eventMode="none">
      <slot name="icon" />
    </Group>
    <Rect id="disabledShade" left="0" right="0" top="0" bottom="0" fillColor="#25322d" fillAlpha="0.18" radius="18" visible="{disabled}" eventMode="none" />
  </Group>
</Scene>
